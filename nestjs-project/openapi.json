        },
        "summary": "Get the thumbnail of a ready video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitVideoUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "holiday.mp4",
            "description": "Original file name, used for the default title and download.",
            "minLength": 1,
            "maxLength": 255
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4",
            "description": "Declared media type: video/mp4, video/quicktime, video/webm or video/x-matroska."
          },
          "size_bytes": {
            "type": "number",
            "example": 52428800,
            "minimum": 1,
            "description": "File size in bytes (maximum 10 GiB, enforced by the service)."
          },
          "title": {
            "type": "string",
            "example": "My holiday",
            "minLength": 1,
            "maxLength": 100,
            "description": "Defaults to the file name without extension."
          }
        },
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ]
      },
      "PartUrlResponse": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned URL: send the part bytes with PUT and keep the ETag response header."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "InitVideoUploadResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "description": "11-character public id"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "part_size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "part_count": {
            "type": "number",
            "example": 103
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 21600
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlResponse"
            }
          }
        },
        "required": [
          "public_id",
          "title",
          "status",
          "part_size_bytes",
          "part_count",
          "expires_in_seconds",
          "parts"
        ]
      },
      "RefreshPartUrlsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "example": [
              2,
              3
            ],
            "description": "Part numbers (1-based) that need a fresh presigned URL.",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "RefreshPartUrlsResponse": {
        "type": "object",
        "properties": {
          "expires_in_seconds": {
            "type": "number",
            "example": 21600
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlResponse"
            }
          }
        },
        "required": [
          "expires_in_seconds",
          "parts"
        ]
      },
      "CompletedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "description": "Part number (1-based) as issued at initialization."
          },
          "etag": {
            "type": "string",
            "example": "\"9bb58f26192e4ba00f01e2e7b136bbd8\"",
            "description": "ETag header returned by the storage when the part was uploaded."
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteVideoUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "Every uploaded part, each exactly once.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteVideoUploadResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "public_id",
          "status"
        ]
      },
      "VideoStatusResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "public_id",
          "status",
          "failure_reason"
        ]
      },
      "VideoDetailsResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "example": 212.48,
            "description": "Duration in seconds"
          },
          "size_bytes": {
            "type": "number",
            "example": 52428800
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Technical metadata extracted by the worker: format, bit_rate, video and audio streams."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "stream_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/stream"
          },
          "download_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/download"
          },
          "thumbnail_url": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/thumbnail"
          }
        },
        "required": [
          "public_id",
          "title",
          "duration_seconds",
          "size_bytes",
          "content_type",
          "metadata",
          "created_at",
          "stream_url",
          "download_url",
          "thumbnail_url"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}